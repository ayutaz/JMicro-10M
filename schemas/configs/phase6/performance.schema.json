{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded Phase6 selected-model performance and strict resume study",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "scope", "shards", "model_source", "tokenizer", "tokenizer_sha256", "shard_manifest_sha256", "seed", "context", "dtype", "accumulation", "lr", "weight_decay", "warmup", "memory_fraction", "short_probe_updates", "short_probe_warmup", "maximum_capacity_points_per_variant", "maximum_batch_probe", "confirmation_repeats", "confirmation_updates", "exact_stable_updates", "exact_stable_split", "exact_decay_updates", "exact_decay_split", "evaluation_documents", "generation_cases", "generation_tokens", "worker_timeout_seconds", "variants", "acceptance"],
  "properties": {
    "version": {"const": 3},
    "scope": {"const": "Phase6 step3 resource and performance verification only; no long Base training"},
    "shards": {"type": "string", "minLength": 1},
    "model_source": {"const": "reports/phase5/candidate_configs.json:100m-no-qknorm"},
    "tokenizer": {"const": "artifacts/phase2/4096/tokenizer.model"},
    "tokenizer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "shard_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "seed": {"const": 42},
    "context": {"const": 1024},
    "dtype": {"const": "bf16"},
    "accumulation": {"const": 1},
    "lr": {"const": 0.002},
    "weight_decay": {"const": 0.1},
    "warmup": {"const": 20},
    "memory_fraction": {"const": 0.94},
    "short_probe_updates": {"const": 32},
    "short_probe_warmup": {"const": 8},
    "maximum_capacity_points_per_variant": {"const": 16},
    "maximum_batch_probe": {"const": 256},
    "confirmation_repeats": {"const": 3},
    "confirmation_updates": {"const": 200},
    "exact_stable_updates": {"const": 200},
    "exact_stable_split": {"const": 100},
    "exact_decay_updates": {"const": 100},
    "exact_decay_split": {"const": 50},
    "evaluation_documents": {"const": 4},
    "generation_cases": {"const": 1},
    "generation_tokens": {"const": 8},
    "worker_timeout_seconds": {"const": 1200},
    "variants": {"type": "array", "minItems": 1, "maxItems": 8,
      "items": {"type": "object", "additionalProperties": false, "required": ["name", "backend", "compile", "training_fast_path", "deterministic"],
        "properties": {"name": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "backend": {"enum": ["math", "flash"]}, "compile": {"type": "boolean"}, "compile_mode": {"enum": ["default", "reduce-overhead", "max-autotune-no-cudagraphs"]}, "training_fast_path": {"type": "boolean"}, "deterministic": {"type": "boolean"}}}},
    "acceptance": {"type": "string", "minLength": 1}
  }
}
