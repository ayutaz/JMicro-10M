      "grammar": 0,
      "relevance": 0,
      "context": 0,
      "rationale": "おおの反復が続き水族館やクラゲの報告を扱わない。"
    },
    {
      "key": "own-chat-086-turn-1",
      "grammar": 1,
      "relevance": 1,
      "context": 1,
      "rationale": "短いおーを四度重ねるだけで靴への具体的反応がない。"
    },
    {
      "key": "own-chat-086-turn-2",
      "grammar": 1,
      "relevance": 1,
      "context": 0,
      "rationale": "おーを五度重ね靴のきつさや距離を減らした点を扱わない。"
    },
    {
      "key": "own-chat-087-turn-1",
      "grammar": 2,
      "relevance": 1,
      "context": 1,
      "rationale": "料理を練習する報告を自分が習う話として言い直すだけ。"
    },
    {
      "key": "own-chat-087-turn-2",
      "grammar": 2,
      "relevance": 1,
      "context": 1,
      "rationale": "卵焼きへの感想は自然だが形がうまくできた報告への反応が薄い。"
    },
    {
      "key": "own-chat-089-turn-1",
      "grammar": 2,
      "relevance": 1,
      "context": 1,
      "rationale": "祖母への電話へ祝う言葉を返すが祝い事ではなく反応が曖昧。"
    },
    {
      "key": "own-chat-089-turn-2",
      "grammar": 2,
      "relevance": 1,
      "context": 1,
      "rationale": "労いは自然だが元気な祖母と話せた喜びへの反応が薄い。"
    },
    {
      "key": "own-chat-090-turn-1",
      "grammar": 2,
      "relevance": 2,
      "context": 2,
      "rationale": "音楽を聴く楽しさへの自然な肯定として返答が成立する。"
    },
    {
      "key": "own-chat-090-turn-2",
      "grammar": 1,
      "relevance": 1,
      "context": 1,
      "rationale": "ピアノの話には沿うが質問の主語と接続が不自然で落ち着きに応じない。"
    },
    {
      "key": "own-chat-091-turn-1",
      "grammar": 2,
      "relevance": 2,
      "context": 2,
      "rationale": "辛いものが苦手という相手の話を自然な確認として受ける。"
    },
    {
      "key": "own-chat-091-turn-2",
      "grammar": 2,
      "relevance": 2,
      "context": 1,
      "rationale": "カレーへの自然な肯定だが辛いものが苦手という履歴は曖昧。"
    },
    {
      "key": "own-chat-091-turn-3",
      "grammar": 1,
      "relevance": 1,
      "context": 1,
      "rationale": "甘口と苦手の語は拾うが適した辛さを明確に答えない。"
    },
    {
      "key": "own-chat-092-turn-1",
      "grammar": 2,
      "relevance": 1,
      "context": 1,
      "rationale": "6時の起床予定を保持するが自分の予定として反響するだけ。"
    },
    {
      "key": "own-chat-092-turn-2",
      "grammar": 2,
      "relevance": 1,
      "context": 1,
      "rationale": "家を出ることには触れるが自分の話に変え7時を落とす。"
    },
    {
      "key": "own-chat-092-turn-3",
      "grammar": 2,
      "relevance": 0,
      "context": 0,
      "rationale": "10時という履歴にない時刻を答え6時の起床予定を失う。"
    },
    {
      "key": "own-chat-094-turn-1",
      "grammar": 2,
      "relevance": 2,
      "context": 2,
      "rationale": "駅まで歩いて20分かかる負担へ自然に共感している。"
    },
    {
      "key": "own-chat-094-turn-2",
      "grammar": 0,
      "relevance": 1,
      "context": 1,
      "rationale": "足が痛いのはという未完節を上限まで反復している。"
    },
    {
      "key": "own-chat-094-turn-3",
      "grammar": 1,
      "relevance": 0,
      "context": 0,
      "rationale": "バスがあるからないと矛盾し足の痛みに合う選択をしない。"
    },
    {
      "key": "own-chat-095-turn-1",
      "grammar": 1,
      "relevance": 1,
      "context": 1,
      "rationale": "日曜の掃除という話は拾うが同じ文を二度反響する。"
    },
    {
      "key": "own-chat-095-turn-2",
      "grammar": 1,
      "relevance": 0,
      "context": 0,
      "rationale": "午後の未完節を重ね午前中の掃除という予定を取り違える。"
    },
    {
      "key": "own-chat-095-turn-3",
      "grammar": 1,
      "relevance": 0,
      "context": 0,
      "rationale": "今日午後の買い物という話を創作し土曜日を答えない。"
    },
    {
      "key": "own-chat-096-turn-1",
      "grammar": 2,
      "relevance": 1,
      "context": 1,
      "rationale": "猫の名前という話題を確認するだけでミケへの反応がない。"
    },
    {
      "key": "own-chat-096-turn-2",
      "grammar": 2,
      "relevance": 0,
      "context": 0,
      "rationale": "猫の名前へ戻り段ボールが好きという新しい報告を扱わない。"
    },
    {
      "key": "own-chat-096-turn-3",
      "grammar": 2,
      "relevance": 1,
      "context": 0,
      "rationale": "記憶の有無には答えるが履歴の猫の名前ミケを忘れている。"
    },
    {
      "key": "own-chat-097-turn-1",
      "grammar": 2,
      "relevance": 2,
      "context": 2,
      "rationale": "夕飯のうどんに自然な肯定を返している。"
    },
    {
      "key": "own-chat-097-turn-2",
      "grammar": 2,
      "relevance": 2,
      "context": 2,
      "rationale": "暑いため冷たいものにする希望へ自然に同意する。"
    },
    {
      "key": "own-chat-097-turn-3",
      "grammar": 2,
      "relevance": 2,
      "context": 2,
      "rationale": "ねぎが苦手という相手の制約を自然な確認で受けている。"
    },
    {
      "key": "own-chat-097-turn-4",
      "grammar": 2,
      "relevance": 1,
      "context": 0,
      "rationale": "ねぎの苦手を再質問するだけで冷たいうどんとねぎ抜きをまとめない。"
    },
    {
      "key": "own-chat-099-turn-1",
      "grammar": 2,
      "relevance": 1,
      "context": 1,
      "rationale": "クッキーの話には触れるが作る報告を材料として使う話へ変える。"
    },
    {
      "key": "own-chat-099-turn-2",
      "grammar": 2,
      "relevance": 0,
      "context": 0,
      "rationale": "ナッツが食べられないという制約へおいしいと肯定を返す。"
    },
    {
      "key": "own-chat-099-turn-3",
      "grammar": 2,
      "relevance": 2,
      "context": 1,
      "rationale": "チョコを入れる希望には自然に応じるがナッツ制約は未確認。"
    },
    {
      "key": "own-chat-099-turn-4",
      "grammar": 2,
      "relevance": 1,
      "context": 0,
      "rationale": "ナッツの感想を述べるだけで食べられない条件への注意を答えない。"
    },
    {
      "key": "own-chat-100-turn-1",
      "grammar": 0,
      "relevance": 1,
      "context": 0,
      "rationale": "机の上にという未完節を反復し窓際の配置を扱わない。"
    },
    {
      "key": "own-chat-100-turn-2",
      "grammar": 0,
      "relevance": 1,
      "context": 1,
      "rationale": "直射日光はという語を反復し避けるための返答を終えられない。"
    },
    {
      "key": "own-chat-100-turn-3",
      "grammar": 0,
      "relevance": 1,
      "context": 0,
      "rationale": "午後に日が弱くなると逆転させ直射日光の未完節を反復する。"
    },
    {
      "key": "own-chat-100-turn-4",
      "grammar": 1,
      "relevance": 1,
      "context": 0,
      "rationale": "置きたい場所を置きたくないと矛盾させ日光を確認する要求を失う。"
    }
