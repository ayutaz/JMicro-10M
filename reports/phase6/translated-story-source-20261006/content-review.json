  "manifest_sha256": "f36ce79cde300ef02e726f9036a8dbf9ce0f516deeb279c1cac023677737cd18",
  "pilot_sha256": "6f97b42a3178a76de56748e0608617a4da4559360564c16e7e2ab092c80f310f",
  "notes_sha256": "0fea8d931757752dc0bf11037c4b1d22c33cfdbd1d2e57479a8f0be1de9b9cc5",
  "notes": [
    {
      "id": "translation-offset-119299647",
      "text_sha256": "e194e470f3ab4552b5684a728e4041e52cabe5bf66c8f3ffb363410445d6afd6",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "姉妹が失くした玩具を共同で探し、物音を手掛かりに発見する。音の原因の省略は矛盾ではなく、主体と目的が保たれる。"
    },
    {
      "id": "translation-offset-82601432",
      "text_sha256": "ca2773cf7475cc61f3505ec40a23e88d0ef64c9c802051c30c2d922df4a1ff77",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "母の依頼を受けて石炭を運び、感謝されるまでの作業と感情の因果が明確。小屋から母へ声が届く状況は可能。"
    },
    {
      "id": "translation-offset-144044756",
      "text_sha256": "63c2b0a3d866e564e602db88cf0cf59dba69fc5a1059c64052c6a65a4ce0b538",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "庭作りで疲れたサムを母が手伝い、二人で完成する。肩の重さは疲労の比喩として自然で、結末も目的に対応する。"
    },
    {
      "id": "translation-offset-81189922",
      "text_sha256": "e09874454ff0baf720863ad7af36f1c155fb5ea1bae52d324d9e7b2f53598f83",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "花と風船を見て喜び、母と記憶を共有する叙情的な場面。具体的な思い出の省略は事実の矛盾としない。"
    },
    {
      "id": "translation-offset-146487787",
      "text_sha256": "c9efee41ef33d0b30062535cf0f84c9d096f24cdb04c12aa372613092127ae0a",
      "content_quality": 1,
      "weak_document": true,
      "unresolved_grammar_issue": true,
      "unresolved_grounding_issue": false,
      "reason": "かくれんぼの鬼を「めかしめ」と記す未解消の日本語表現がある。犬と友人の登場自体は創作として可能だが、この語は役割を正しく伝えない。"
    },
    {
      "id": "translation-offset-184852651",
      "text_sha256": "ff419ca13c7a7856d587282e13cd93871b49553593ccc97b9bb8473d0c4e416d",
      "content_quality": 1,
      "weak_document": true,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "拾った女の子の消しゴムを返す流れは成立するが、最後のジョン自身が消しゴムを失くしたくないという理由への接続が弱い。所有者の明示的矛盾とまでは断定しない。"
    },
    {
      "id": "translation-offset-142366979",
      "text_sha256": "f6bcbaaae14bebe3587b2922a4cc8cab17709fbd7262678be6a99aa300478986",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "ネズミが追跡する猫から細い枝へ逃げる作戦を実行する。動物の会話や感情は寓話として認め、目的と結果は一貫している。"
    },
    {
      "id": "translation-offset-106619655",
      "text_sha256": "3c0f90349d9abb6aff970dbd33d57e460cd4d853de7a5eab0a3dac8d60a46189",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "擬人化した足の指が走り、途中到達を友人に祝われる。完走できなかった状態も維持し、幻想設定を物理的不可能という理由で失敗にしない。"
    },
    {
      "id": "translation-offset-157434066",
      "text_sha256": "666b2fae1fa462a873f1c20ebf8a57d85f6dc7eea5bde039c38be3e9f5914c47",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "母の許可後、年配のサーファーと海で遊び、帰宅時に別れる。短時間の上達と年齢設定は創作上の誇張で、内部の主体・順序の矛盾はない。"
    },
    {
      "id": "translation-offset-184036271",
      "text_sha256": "ea4697e20a8abdb13a800fa7eed634924702c04f10e6cce12f703e2a22687676",
      "content_quality": 1,
      "weak_document": true,
      "unresolved_grammar_issue": true,
      "unresolved_grounding_issue": false,
      "reason": "謝罪と歯磨きの二つの行動は読めるが、両親の場面で「パパとうさぎは顔を見合わせて」となる参照表現が不自然。ママうさぎを指す自然な表現に至っていない。"
    },
    {
      "id": "translation-offset-184291486",
      "text_sha256": "2e9131239d4cf0b6d5668c1b1dbd735c3bd4209c07c8daf606a94a6be4dfe3bf",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "病気になったフルート好きの少年が休養し回復する。物語と健康を大切にする教訓は接続しており、医学的外部認証とは扱わない。"
    },
    {
      "id": "translation-offset-73967529",
      "text_sha256": "53f209e6d89c6d334d4d93492d80049367fe216d9d3004deb8a022864c3d7bb5",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "ジェフが秘密の話を友人へ語り、楽しんでもらい再度の依頼を受ける。中の物語本文が省略されても、語り手の出来事として完結する。"
    },
    {
      "id": "translation-offset-95022632",
      "text_sha256": "def7a42807c542c4c882d0dad1831e69576462377d2bcb5169ac1a9b7a01fcdf",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "勇敢な少女が地下室を探検し、再訪を決める。正直という初期属性が使われないことだけで正常な話を弱いとしない。"
    },
    {
      "id": "translation-offset-182892325",
      "text_sha256": "7321a8b1139227f3161f69ceb0d0a346677d04729f1e6f8a57bada048c6a7167",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "寒さと氷の揺れを受けて陸へ戻り、翌朝には融けた湖を見る。夜の暖かさと翌朝の変化は可能で、融解速度だけを現実検証なしに矛盾としない。"
    },
    {
      "id": "translation-offset-63583196",
      "text_sha256": "11f35f8ff0274d2a16762f41ae46d907f81548f91c65453d7b2d94170f7bf944",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "岩から光を見つけて鉄の剣を得る冒険が順序通りに描かれる。剣が安心感を与えるという本人の感情も一貫する。"
    },
    {
      "id": "translation-offset-108718857",
      "text_sha256": "38b7e98ac70eb1d4e9488c073d51636627c6f45a86336155e5486418cbf2055e",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "少女が知らない男性の車を追って乗り、監禁される暗い結末。怖さを感じる時点と逃げられない結果は整合し、悲劇を自動的な内容失敗にしない。"
    },
    {
      "id": "translation-offset-114697270",
      "text_sha256": "3978ee0c43373c194349d510c048092964b7ea5ea5e5dbef5366f8f389bab697",
      "content_quality": 1,
      "weak_document": true,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": true,
      "reason": "店の盗難に遭った買い手の画家が追跡するが、未購入の絵の具を「自分の絵の具」「取り戻す」と所有済みに扱う接続が未解消。対象の所有関係を補う説明は本文にない。"
    },
    {
      "id": "translation-offset-125866508",
      "text_sha256": "bf2c32bd1ee522b09aaeb242da9c03aad9628989482c288a0f88eddbd0249790",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "容姿への傷つける発言を指摘し、虹を共有することで親切な交流へ戻る。天井の穴から虹が見えることは物語設定として可能。"
    },
    {
      "id": "translation-offset-109487348",
      "text_sha256": "43860ea4334197388a3eb7a78fdad51dc51868b26b9ff8036574a1d74e00146b",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "灰皿に飛び込む少女という奇妙な設定でも、跳ぶ準備・実行・満足の順序は保たれる。大きさや幻想設定を本文にない現実尺度で否定しない。"
    },
    {
      "id": "translation-offset-142445959",
      "text_sha256": "1ed52b6f51a48fb3bab1bf53334ab699264a0e9b16ac822b569ed37cc76acd78",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "後悔する男性を少女が見守り、友人になる。償う対象は抽象的だが、支援と関係の変化は読める完結文。"
    },
    {
      "id": "translation-offset-106893520",
      "text_sha256": "51340145f252e92cc0fef2788d0824e8d0258fe26e618c57511317172256e40e",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "袋の子猫を保護して母に見せ、友人になる流れが明確。毎日揺れながら過ごす描写は幼児向けの誇張として許容する。"
    },
    {
      "id": "translation-offset-139195839",
      "text_sha256": "d1ee19b43a5e25cbe5ca5b9735a67bf07a29fbda7aa4e003b3736be4573af23e",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "体の柔らかいおじと少女がかくれんぼをして楽しむ。属性が直接使われないことだけで弱い学習文書と判断しない。"
    },
    {
      "id": "translation-offset-138524792",
      "text_sha256": "4b3a030f7f2ee160f19ca0a13275aeb841b9b6b20af205127a6033577a353217",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "公園で転んだ少女を母が助け、注意を再度伝える。柔らかい靴が壊れない説明は単純だが、靴が脱げる時点と救助は整合する。"
    },
    {
      "id": "translation-offset-105602516",
      "text_sha256": "e918c05d9a2667776c0a49042f1cc946fae7136b5d7429aa4d1aa93b469c0492",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "重いマイクを友人二人が協力して移動し祝う。サイズは明示設定で、一般的なマイクとの差だけで矛盾にしない。"
    },
    {
      "id": "translation-offset-109998394",
      "text_sha256": "f6f9a94bb04494e54975059a4446f8cb93edd622dddc5433475438e4fbbc64bd",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "拾ったフォークを男性へ渡した少女が後悔する話。腹の感覚は後悔の身体的比喩で、悲しい結末も成立する。"
    },
    {
      "id": "translation-offset-93252811",
      "text_sha256": "7d8880b411a429644323275cd049fdcf59ac4ea027e6e57ccb1cb5c17a9dd0cf",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "森で迷った少年が小屋のおじいさんに見つけられ帰る。「誰にも声は届かない」と後の目視による発見は両立する。"
    },
    {
      "id": "translation-offset-123566203",
      "text_sha256": "80cb9153ae8eac2fbcbaf94c6db3f1295e588ee282b8721a5993d30803b468af",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "雷と暗雲を見て雨を予測し、仲間と自分が巣穴へ戻る。雨粒が当たり豪雨前に到着する順序と目的が保たれる。"
    },
    {
      "id": "translation-offset-68358160",
      "text_sha256": "40145b0152efc2776d24ba1202ac94d4f0244d24bdb1c162efd22e13beee5760",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "泥池でカエルと遊び帰る少年の話。カエルの会話は明示的な寓話の展開として認め、靴を脱いで履く状態も一貫する。"
    },
    {
      "id": "translation-offset-123272502",
      "text_sha256": "3089877713d2d0a278c53e9c1dee35986b520a89f93dfad95a5912c9f3693c72",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "実を食べたクマが休み、強くなる夢を見て食事を続ける。成長の誇張は童話として許容し、別の主体への飛躍はない。"
    },
    {
      "id": "translation-offset-113986311",
      "text_sha256": "d9364f2c5b04e645866d1b1e788009cad772e067b86803e6d17dc40e2ebc3a6b",
      "content_quality": 1,
      "weak_document": true,
      "unresolved_grammar_issue": true,
      "unresolved_grounding_issue": false,
      "reason": "からかわれた蜂が分け合う結末は理解できるが、「バジーを言い返してやり返しても」は動詞と言い返す相手の格が不自然で、未解消の表現として記録する。"
    },
    {
      "id": "translation-offset-61233101",
      "text_sha256": "ac18635a34109527f2f372844c37b07ab4c1bb4b73e2d6baf58f390e3f04fbdf",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "飛ぶのを怖がる鳥の話から、少女が新しいことに挑戦する教訓を得る。鳥が挑戦する結末の省略は少女の実行と矛盾しない。"
    },
    {
      "id": "translation-offset-183559952",
      "text_sha256": "7d29b874f1afcd1a52191691c87a8df492150e8482a1e251f5979c1b29163b44",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "鐘を見て触れ音を鳴らす少年の体験が順序通りに描かれる。押して鳴る方式は可能で、音と喜びが自然に接続する。"
    },
    {
      "id": "translation-offset-85646131",
      "text_sha256": "8af8a1570602570bca1f7c52fe01cc7dd2ef477de677da8d4aa622a0d9f71a76",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "フクロウがリスと交渉し失くした羽を返して鳥が飛ぶ話。羽一枚の重要性と擬人化は寓話設定として認める。"
    },
    {
      "id": "translation-offset-114761218",
      "text_sha256": "f60963c3ab70c204dfc69afa9c4e9551abd8f78bd4121dd04bc60c05b0c1af8d",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "骨折を検査し、ギプス期間を経て回復する。時間経過と遊びへ戻る結末は一貫し、外部の医学的保証とは別に評価する。"
    },
    {
      "id": "translation-offset-159766344",
      "text_sha256": "0d4a0ae452c67a4cee5b94e8aa6ef118d4fadf350e2dddcf3a5297049f7c4f1b",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "玩具を盗った友人へ気持ちを伝え、返却と謝罪で関係を修復する。プール作りの前後も同じ友人と目的を保つ。"
    },
    {
      "id": "translation-offset-138240532",
      "text_sha256": "6a3fd86296288d597a2c345199700648542805c68c85cbf9656699aba693a3ce",
      "content_quality": 1,
      "weak_document": true,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": true,
      "reason": "ドアを閉めたのはパパと明示するが、最後は姉妹が二度とドアを閉めないという行動へ置換される。姉妹が閉めた出来事も禁じられた事情もなく、結末の主体・理由が未解消。"
    },
    {
      "id": "translation-offset-75565719",
      "text_sha256": "862bef86e03fd5bd95da42d6fae80d535673dce14a806a9c5174532a8ca79f0a",
      "content_quality": 1,
      "weak_document": true,
      "unresolved_grammar_issue": true,
      "unresolved_grounding_issue": false,
      "reason": "財布をもらい公園で盗まれる筋は読めるが、時間移動を「その日のあと」と記すのは日本語として不自然。正常な「その後」へ本文を修正せず問題として保存する。"
    },
    {
      "id": "translation-offset-144004443",
      "text_sha256": "4e2bec0331e1b20e6ea4ebf1161f25607493faffee8d52fa52ce7b0c70ac67e7",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "身体を逆さまにする機械の幻想設定が先に示され、変化と周囲の反応を描く。腕や靴の移動を現実の人体基準で失敗にしない。"
    },
    {
      "id": "translation-offset-70176568",
      "text_sha256": "d295de5dc86f83c7cd445c1ae5b0916b01579ff4f6cb0f1bcd0d86f2b7598e11",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "人形を濡らさないためベンチへ置き、鳥に持ち去られて悲しむ。短く悲しいが、置いた対象と失う結末は一貫する。"
    },
    {
      "id": "translation-offset-171965031",
      "text_sha256": "6f17ac6bad2839fa260db40be3fc4d8573f390d2c0224deed85f867e32c15046",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "擬人化ヘリコプターが森の車を押して救助する。子どもが車から出た後に車を運ぶ順序も成立し、機械の会話は創作として認める。"
    },
    {
      "id": "translation-offset-122810099",
      "text_sha256": "cc0cb90f36012a87d5767efcc6e287aa4e025c76f21ac310fd4d7610619fc612",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "彗星がおもちゃを届ける幻想的な贈り物の話。速さとの因果は誇張だが、受け取って喜ぶ村の主体と結末は保たれる。"
    },
    {
      "id": "translation-offset-99572459",
      "text_sha256": "f082afdeef7f97e9a15146208aba6bed0fac9cef8ab1006e6f9d7b06a700732b",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "摘んだポピーを見せに来た少女が父の頼みで冷たい布を運ぶ。花は前後の背景であり、看病と遊びに戻る順序は自然。"
    },
    {
      "id": "translation-offset-63767759",
      "text_sha256": "f1db9807b67dd9f9355f120490237dd40d6dfaeda6ee7a6dc89de18686f0e95d",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "環境を守る集まりの目的を母に聞き、少女が協力したいと思う。具体的活動の省略は抽象的な短文として許容する。"
    },
    {
      "id": "translation-offset-186096718",
      "text_sha256": "0579edffb553e7d2914ea1bf6c6bdbc33f958823c33b8a83d427d0e8af5797e9",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "自宅のようこそ看板を見つけた少女が家族へ知らせ、喜んでドアを開けるようになる。新看板を喜ぶ反応は可能で矛盾はない。"
    },
    {
      "id": "translation-offset-134997360",
      "text_sha256": "45208753124a9b2a0c00e56d0e7417308df74fbcc9cf6a6f790de4f72129f20c",
      "content_quality": 1,
      "weak_document": true,
      "unresolved_grammar_issue": true,
      "unresolved_grounding_issue": false,
      "reason": "高い玩具を全部買えず、安くても楽しめるという結末は成立するが、「一番素敵なものが、いつも高いお金をかけなければならないわけではない」は物を支出主体にする不自然な節接続がある。"
    },
    {
      "id": "translation-offset-99123131",
      "text_sha256": "ab70c35ae2d95e6b78a60e86434f66aa9a7285f65ecadfb805f884dae11a0813",
      "content_quality": 1,
      "weak_document": true,
      "unresolved_grammar_issue": true,
      "unresolved_grounding_issue": false,
      "reason": "屋台を作って飾る過程は理解できるが、板の接合を「釘で打ち合わせて」とする用語が不自然。工作の打ち付けと相談の打ち合わせが混じった未解消表現。"
    },
    {
      "id": "translation-offset-91057031",
      "text_sha256": "bd2f582fffd38c9bf9704162b9eea4e5f7213e8f57ca45f8d89c700ecad0b57b",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "カエルがテレビのアニメへ入り、終了後に戻る幻想設定。物語内の移動と帰還が対応し、現実には入れないという理由で失敗にしない。"
    },
    {
      "id": "translation-offset-113140557",
      "text_sha256": "3cd560286ca74d49c0abee6ad6f299014676b1001f63717dd540d5f12ca6882b",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "家族が特別な日を飾り、抱き合って祝う。最高・一番の重ね方は冗長だが、口語の強調として読めるため文法失敗とはしない。"
    },
    {
      "id": "translation-offset-182081522",
      "text_sha256": "7b8851a9b8f0731f40e0cd113343eebc61223f246ada8e781ea0d893bad5c12b",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "魔法の紫色の豆を植え、紫色の植物に育つ。母の説明と数日後の結果が一致し、魔法という期待を外部事実にしない。"
    },
    {
      "id": "translation-offset-83327825",
      "text_sha256": "77939f1ac4d07a61d7ad65adafc05061d10c66b46561a0fdb44032403d071f4f",
      "content_quality": 1,
      "weak_document": true,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "大きなネズミに会う大学探検は幻想として可能だが、最後に大学を案内してくれたネズミとされる行動の接続が薄い。案内は省略された可能性もあるため明示的な時系列矛盾とは断定しない。"
    },
    {
      "id": "translation-offset-62398043",
      "text_sha256": "3562471334bffc5007484b1c05ae80f2c04debd49e07ae852b5d9560dacdbb99",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "ハトが子どもを観察し、追いかけられて静かな空へ逃げる。好奇心から安心へ変わる感情と行動が一致している。"
    },
    {
      "id": "translation-offset-178237806",
      "text_sha256": "c2fc65a89ebf6a70d3735849ae172b4c46ad55bd7992dc3c9309ed42098aa06a",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "フィギュアという主人公が歩き、案内を受けてビーチを訪れ帰る。固有名または擬人化として読め、帰りの距離感の変化も疲労からの回復で可能。"
    },
    {
      "id": "translation-offset-190438923",
      "text_sha256": "bf1df0f0120d0114be02a80933943e9017813726b1ee149ef45c3f08c9386518",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "猫が煙から離れて消防士を呼び、消火される短い救助話。猫の目的と行動・結果が一致し寓話として完結する。"
    },
    {
      "id": "translation-offset-157534822",
      "text_sha256": "25967e4473a2253765408dfb013c1d3dcd6c99c5cb7129baeba4e925fd5a7345",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "遊び好きの少女が両親と飛行機を追いかけ、疲れて眠る。窓を見る場面から外へ出る省略は矛盾ではなく、翌朝の再挑戦も一貫する。"
    },
    {
      "id": "translation-offset-189144985",
      "text_sha256": "ec3e90bd2cb9b570613f475d53019aa157a202645e02edc433bb01676b053071",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "旅で植物や動物を助け、最後にそれらの庭を報酬として見る寓話。移動や報酬の機構は幻想設定として許容し、思いやりの教訓と対応する。"
    },
    {
      "id": "translation-offset-81757812",
      "text_sha256": "314fb96f21c73a25e354c09e4417e15f6b61ee31526f0c621f21a14e970268ce",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "勇敢な人物がハリケーンを押し退ける超人的な寓話。勇気で必ず止められるという教訓は物語内の誇張で、現実の災害対策の事実保証とはしない。"
    },
    {
      "id": "translation-offset-151358117",
      "text_sha256": "a3e3c01f800a769c92bb0f4ef39ae9fdd5ec1a5daef10ca05172ec18207da908",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "犬に襲われた子犬を警察官が声で救う。危険と救助の主体が明確で、子犬のお礼は擬人化として一貫する。"
    },
    {
      "id": "translation-offset-83232165",
      "text_sha256": "2683a4fe97a068ce15ae015a3d74dcd773c6ae6c64212846edd58f78d47698d9",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "王が魔法使いへ冠を依頼し、できた冠をかぶって見せる。依頼と結果・継続して使う結末が対応する。"
    },
    {
      "id": "translation-offset-101156043",
      "text_sha256": "1f3fa9a9fb1451d2be540e7c4a67722d422f85777d6fecf1aea6cd28cbba136a",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "教会の箱から見つけた玩具などを子どもへ分ける。箱を開ける協力と共有の結末がつながり、所有の外部事実は保証しない。"
    },
    {
      "id": "translation-offset-192519858",
      "text_sha256": "8dafa486bd48f60d0cbd864da20437937860800089efb66bf74514dab7454157",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "遠い空の宝石へ母娘が到達し、重い宝石を母が運ぶ幻想的な話。大きさや空への移動は童話の省略として読み、持ち帰る対象の状態は一貫する。"
    },
    {
      "id": "translation-offset-178468877",
      "text_sha256": "cc604ae0054d5e612d114d2036da825084511e4f7b0a892ed20d61a7084ffeae",
      "content_quality": 1,
      "weak_document": true,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "ハチを見て手を差し出す行動は読めるが、周囲の遊具を見た後の「ハチさんに決めた」が何を選ぶのか接続せず、目的と結末の情報が弱い。明示的な矛盾とはしない。"
    },
    {
      "id": "translation-offset-192352856",
      "text_sha256": "d9e60fcbf066e2185b1b14142293fbb53614c502a675fc08cd95ad431fbb533b",
      "content_quality": 1,
      "weak_document": true,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "母の警告を無視し池へ落ち救われる筋は成立するが、見つけた毒の具体的対象が示されず危険の描写が曖昧。毒は可視物質の可能性があり内部矛盾や誤訳とは断定しない。"
    },
    {
      "id": "translation-offset-180977821",
      "text_sha256": "15ffd65498531af6dd23c1bc0e05865e231e88b00068da08776f0cc10509deb7",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "警備員がリンゴから虫を除き地面へ移す擬人化寓話。虫の感情と木を守る目的が保たれ、話す木や虫を物理的誤りにしない。"
    },
    {
      "id": "translation-offset-74247230",
      "text_sha256": "7ca9e2b8f4f588246d4231f6941d461d9507790bed4b558a7b9ad6b2488b1493",
      "content_quality": 2,
      "weak_document": false,
      "unresolved_grammar_issue": false,
      "unresolved_grounding_issue": false,
      "reason": "母の警告を聞かず壁へ登った少年が落ち、けがをして警告を聞くようになる。助けようとしても先に落ちた順序は成立する。"
    }
  ],
