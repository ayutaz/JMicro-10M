      "coherence": 2,
      "boilerplate": 2,
      "ending_type": "sentence",
      "natural_prose_body_last": true,
      "flags": [
        "website_search_instructions"
      ],
      "reason": "会社情報検索の使い方と閲覧制限は明確な操作説明。文としては完結するが一般の記事や物語ではない。",
      "full_original_body_read": true
    },
    {
