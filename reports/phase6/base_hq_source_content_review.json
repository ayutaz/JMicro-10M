      "original_text_sha256": "cf2c02952896d80c2d4824521bfeb56d803a4776c43eb0fc2e7067e726d67ca4",
      "source_id": "<urn:uuid:f81bfdda-5dad-4ddf-bae5-5a56cf7ce96c>",
