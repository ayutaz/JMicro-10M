      "grammar": 2,
      "coherence": 2,
      "boilerplate": 2,
      "ending_type": "sentence",
      "natural_prose_body_last": true,
      "flags": [
        "website_navigation_instructions"
      ],
      "reason": "サイト名の由来と掲示板・画像リンクの利用案内は通るが、サイト操作の案内が主目的。",
      "full_original_body_read": true
    },
    {
