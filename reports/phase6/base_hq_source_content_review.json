      "ending_type": "navigation",
      "natural_prose_body_last": false,
      "flags": [
        "glossary",
        "link_tail"
      ],
      "reason": "マーケティング用語の短い定義は完結するが、末尾に用語集への移動とサイトメニューがある。",
      "full_original_body_read": true
    },
    {
