      "source_row": 48751,
      "native_body_tokens": 1066,
      "body_UTF8_bytes": 4024,
      "grammar": 2,
      "coherence": 2,
      "boilerplate": 0,
      "ending_type": "sentence",
      "natural_prose_body_last": true,
      "flags": [
        "medical_article",
        "intentional_summary_repetition"
      ],
      "reason": "下剤の説明から原因の列挙、使い方への結びまで文章としてまとまる。冒頭の説明の再掲は要約。医療内容を正しい治療助言として検証したわけではない。",
      "full_original_body_read": true
    },
    {
