      "source_row": 48670,
      "native_body_tokens": 994,
      "body_UTF8_bytes": 3221,
      "grammar": 2,
      "coherence": 2,
      "boilerplate": 0,
      "ending_type": "question",
      "natural_prose_body_last": true,
      "flags": [
        "technical_article"
      ],
      "reason": "検索機能を複数の具体例で説明し、意味理解の所感と日本語への問いで終わる。問いでの結びは不完全文として扱わない。",
      "full_original_body_read": true
    },
    {
