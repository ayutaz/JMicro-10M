      "original_text_sha256": "d1b4d1e6d5e43deefb92d269ffda5f57294c9263dc0178a75de99518b15f2b1c",
      "source_id": "<urn:uuid:d2678c81-8273-4527-bff9-4c0e9f4deaac>",
      "source_file": "jpn_Jpan/000_00000.parquet",
      "source_row": 48075,
      "native_body_tokens": 212,
      "body_UTF8_bytes": 669,
      "grammar": 2,
      "coherence": 1,
      "boilerplate": 2,
      "ending_type": "UI_notification",
      "natural_prose_body_last": false,
      "flags": [
        "catalogue",
        "advertising",
        "UI_tail"
      ],
      "reason": "歌手の短い経歴と発売情報はあるが広告見出し・楽曲属性が中心で、末尾は引用保存不能の通知。",
      "full_original_body_read": true
    },
    {
      "index": 34,
      "original_text_sha256": "7f1facce82b4f0d170c98e67c81e9650b8f9a6e5a7ee34a3ef2f525660e300d3",
      "source_id": "<urn:uuid:7beb2d40-192a-421f-85a2-b2fb9b5c2ed4>",
      "source_file": "jpn_Jpan/000_00000.parquet",
      "source_row": 48791,
      "native_body_tokens": 204,
      "body_UTF8_bytes": 707,
      "grammar": 2,
      "coherence": 2,
      "boilerplate": 1,
      "ending_type": "navigation",
      "natural_prose_body_last": false,
      "flags": [
        "travel_note",
        "link_tail"
      ],
      "reason": "寺院訪問の移動・料金・待機の経験は自然に説明される。最後は次ページや旅行記トップなどのリンク欄。",
      "full_original_body_read": true
    },
    {
      "index": 35,
      "original_text_sha256": "38c4272f1fb06d1deefb0ec5b16640926d7cdfb0f200a294eee6e1c9e091fdc3",
      "source_id": "<urn:uuid:4b344ba6-10c7-4d93-8ff0-98122c895c6f>",
